{
  "name": "@pikspeak/mobile",
  "version": "0.1.0",
  "description": "PiksPeak Mobile App - AI-powered football predictions",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/react-native/node_modules/@react-native/package.json';fs.existsSync(require('path').dirname(p))&&!fs.existsSync(p)&&fs.writeFileSync(p,'{\\\"name\\\":\\\"@react-native\\\",\\\"private\\\":true}');\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~55.0.0",
    "expo-notifications": "~55.0.0",
    "expo-secure-store": "~55.0.0",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-purchases": "^8.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~5.9.2"
  }
}
