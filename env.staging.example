# -----------------------------------------------------------------------------
# PiksPeak Staging Profile
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PORT=3000

# Database / Cache
DATABASE_URL=postgresql://replace-user:replace-pass@replace-host:5432/pikspeak_staging
REDIS_URL=redis://replace-host:6379

# Auth
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret

# Sports Data APIs
SPORTS_DATA_PROVIDER=sportmonks
API_FOOTBALL_KEY=replace-with-api-football-key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_MAX_REQUESTS=100
# API-Football season strategy (safe for restricted plans)
API_FOOTBALL_SEASON_MODE=range
API_FOOTBALL_SEASON_LIST=
API_FOOTBALL_SEASON_FROM=2022
API_FOOTBALL_SEASON_TO=2024
SPORTMONKS_API_KEY=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION_MAP=39:PL,140:PD,78:BL1,135:SA,61:FL1
ODDS_API_KEY=replace-with-odds-api-key

# Web Intelligence (enabled with tighter limits in staging)
TAVILY_API_KEY=replace-with-tavily-key
WEB_INTEL_ENABLED=true
WEB_INTEL_RECENCY_HOURS=48
WEB_INTEL_MAX_QUERIES_PER_MATCH=1
WEB_INTEL_MAX_RESULTS_PER_QUERY=3
WEB_INTEL_TIMEOUT_MS=5000
WEATHER_INTEL_ENABLED=false
WEATHER_INTEL_TIMEOUT_MS=5000
LOCATION_INTEL_ENABLED=false
LOCATION_INTEL_TIMEOUT_MS=5000

# Scheduler (UTC)
CRON_FIXTURE_SYNC_HOUR_UTC=2
CRON_PIPELINE_HOUR_UTC=5
CRON_REPREDICTION_HOUR_UTC=9
CRON_RESULT_TRACKER_MINUTE_UTC=30
CRON_METRICS_HOUR_UTC=22
CRON_CLOSING_ODDS_MINUTE_UTC=15
CRON_CLOSING_ODDS_INTERVAL_HOURS=2

# Fixture Sync
FIXTURE_SYNC_ENABLED=true
FIXTURE_SYNC_HORIZON_DAYS=5
FIXTURE_SYNC_LEAGUE_IDS=39,140,78,135,61
FIXTURE_SYNC_STATUS_FILTER=NS-TBD-1H-2H-HT-LIVE-FT-AET-PEN-PST-CANC-ABD
FIXTURE_SYNC_CACHE_TTL_SECONDS=180
FIXTURE_SYNC_STALE_SCHEDULED_HOURS=24
CSV_FIXTURE_IMPORT_ENABLED=false
CSV_FIXTURE_FILES=
CSV_FIXTURE_LEAGUE_MAP=E0:39,SP1:140,D1:78,I1:135,F1:61
CSV_FIXTURE_FROM=2022-01-01
CSV_FIXTURE_TO=2025-07-31
CSV_FIXTURE_MAX_ROWS=0
HISTORICAL_FIXTURE_SEED_FROM=2022-01-01
# empty means "today"
HISTORICAL_FIXTURE_SEED_TO=
HISTORICAL_FIXTURE_SEED_LEAGUE_IDS=
HISTORICAL_FIXTURE_SEED_SEASON_LIST=2022,2023,2024
HISTORICAL_FIXTURE_SEED_STATUS_FILTER=FT-AET-PEN-PST-CANC-ABD
HISTORICAL_FIXTURE_SEED_CHUNK_DAYS=365
HISTORICAL_FIXTURE_SEED_REQUEST_DELAY_MS=6500
HISTORICAL_FIXTURE_SEED_CACHE_TTL_SECONDS=86400

# Prediction Pipeline
PIPELINE_MATCH_LOOKAHEAD_HOURS=36
PIPELINE_DIRECT_FETCH_ENABLED=true
PIPELINE_API_STATUS_FILTER=NS
PIPELINE_LEAGUE_IDS=
VALUE_BET_EDGE_THRESHOLD=0.10
VALUE_BET_LOOKAHEAD_DAYS=2
VALUE_BET_KELLY_MULTIPLIER=0.10
VALUE_BET_MAX_STAKE=0.05
ODDS_API_REGIONS=eu,uk
ODDS_API_MARKETS=h2h,totals,btts
ODDS_API_ODDS_FORMAT=decimal
ODDS_API_SPORT_KEYS=39:soccer_epl,140:soccer_spain_la_liga,78:soccer_germany_bundesliga,135:soccer_italy_serie_a,61:soccer_france_ligue_one

# Calibration
CLOSING_ODDS_LOOKAHEAD_HOURS=2

# AI Gateway
AI_GATEWAY_API_KEY=replace-with-ai-gateway-key
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
PREDICTION_MODEL=anthropic/claude-sonnet-4-5-20250514
ENSEMBLE_MODELS=
COUNCIL_MEMBER_MODELS=anthropic/claude-opus-4.6,xai/grok-4,google/gemini-3.1-pro-preview,openai/gpt-5.2
COUNCIL_DECIDER_MODEL=anthropic/claude-opus-4.6
COUNCIL_QUORUM=3
COUNCIL_MEMBER_TIMEOUT_MS=90000
COUNCIL_DECIDER_TIMEOUT_MS=120000
COUNCIL_MAX_RETRIES=2
COUNCIL_REASONING_EFFORT=high
COUNCIL_WEB_SEARCH_ENABLED=true
COUNCIL_TRACE_FULL_JSON=true
COUNCIL_MODEL_PRICING_USD_PER_1M={"anthropic/claude-opus-4.6":{"input":5,"output":25},"xai/grok-4":{"input":3,"output":15},"google/gemini-3.1-pro-preview":{"input":2,"output":12},"openai/gpt-5.2":{"input":1.75,"output":14}}
MATCH_CSV_EXPORT_ENABLED=true
MATCH_CSV_EXPORT_DIR=output/match-csv
MATCH_CSV_EXPORT_FILENAME=match-prediction-versions-latest.csv
MATCH_CSV_EXPORT_INCLUDE_PENDING=true
MATCH_CSV_EXPORT_INCLUDE_FINISHED=true
MATCH_CSV_EXPORT_SNAPSHOT_ENABLED=false
MATCH_CSV_EXPORT_TIMEZONE=UTC

# Optional legacy provider keys (kept for compatibility)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# API / Admin
CORS_ORIGINS=https://staging.pikspeak.app
ADMIN_API_KEY=replace-with-admin-key
REVENUECAT_WEBHOOK_SECRET=replace-with-revenuecat-webhook-secret

# Mobile
EXPO_PUBLIC_API_URL=https://staging-api.pikspeak.app
